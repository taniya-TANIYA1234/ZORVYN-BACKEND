    </form>

</div>

 </div> 

<hr>
<div class="container mt-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold">All Records</h1>
    </div>

    <div class="text-end mb-3">
        <a href="/records/create" class="btn btn-success">
            Create New Record
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover table-striped align-middle text-center bg-white shadow">

            <thead class="table-dark">
                <tr>
                    <th>U_name</th>
                    <th>Role</th>
                    <th>Amount</th>
                    <th>Notes</th>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Created At</th>
                    <th>Delete</th>
                    <th>Update</th>
                </tr>
            </thead>

            <tbody>
                <% for(let record of records){ %>
                    <tr>
                        <td>
                          <%= record.user ? record.user.username : "No User" %>
                            
                        </td>

                        <td>
                            <span class="badge bg-primary">Admin</span>
                        </td>

                        <td class="fw-bold">
                            ₹ <%= record.amount.toLocaleString("en-IN") %>
                        </td>

                        <td>
                            <%= record.notes %>
                        </td>

                        <td>
                            <% if(record.type === "Income"){ %>
                                <span class="badge bg-success">Income</span>
                            <% } else { %>
                                <span class="badge bg-danger">Expense</span>
                            <% } %>
                        </td>

                        <td>
                            <%= record.category %>
                        </td>

                        <td>
                            <%= new Date(record.createdAt).toLocaleString() %>
                        </td>

                        <td>
                            <form action="/records/<%= record._id %>?_method=DELETE" method="POST">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    Delete
                                </button>
                            </form>
                        </td>

                        <td>
                            <a href="/records/<%= record._id %>/edit" class="btn btn-warning btn-sm">
                                Edit
                            </a>
                        </td>

                    </tr>
                <% } %>
            </tbody>

        </table>
    </div>

</div>

   