
<% layout('layouts/basicCode') %>
<form action="/login/logout" method="POST" class="d-inline">
    <button class="btn btn-outline-danger rounded-pill px-3">
        <i class="bi bi-box-arrow-right"></i> Logout
    </button>
</form>
<div class="container mt-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold">All Users</h1>
    </div>
 <div class="table-responsive">
        <table class="table table-bordered table-hover table-striped align-middle text-center bg-white shadow">

            <thead class="table-dark">
        <tr>
            <th rowspan="1" colspan="2">Username</th>
            <th rowspan="1" colspan="3">Email</th>
            <th>Role</th>
            <th>Dashboard</th>
            <th>User</th>
            <th>Update</th>
        </tr>
    </thead>
    <tbody>
        <% for(let user of users){ %>
            <tr>
                <td rowspan="1" colspan="2"><%= user.username %></td>
                <td rowspan="1" colspan="3"><%= user.email %></td>
                <td><%= user.role %></td>
                  <td>
                            <a href="/users/<%= user._id %>" class="btn btn-info btn-sm">
                                View
                            </a>
                        </td>
                <td>
                    <form action="/users/<%= user._id %>?_method=DELETE" method="POST">
                        <button type="submit" class="btn btn-danger btn-sm">
                            Remove
                        </button>
                    </form>
                </td>
                <td>
                   <form action="/users/<%= user._id %>/edit" method="GET">
                        <button type="submit" class="btn btn-primary btn-sm">
                            Update
                        </button>
                    </form>
                </td>
                  
            </tr>
        <% } %>
    </tbody>
</table>

<div class="container mt-4" style="max-width: 400px;">


    <form action="/users/signup" method="get" class="bg-white p-3 border rounded">

